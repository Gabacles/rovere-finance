generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  financialAccounts FinancialAccount[]
  creditAccounts CreditAccount[]
  cards         Card[]
  statements    Statement[]
  importBatches ImportBatch[]
  expenses      Expense[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// Authentication credentials; distinct from a bank/financial account.
model Account {
  id                    String @id
  accountId             String
  providerId            String
  userId                String
  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model FinancialAccount {
  id        String @id @default(uuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String @db.VarChar(100)
  currency  String @default("BRL") @db.VarChar(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  importBlocks ImportBlock[]
  entries BankEntry[]
  @@unique([id, userId])
  @@index([userId])
}

model CreditAccount {
  id          String @id @default(uuid())
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String @db.VarChar(100)
  currency    String @default("BRL") @db.VarChar(3)
  creationKey String @db.VarChar(100)
  createdAt   DateTime @default(now())
  cards       Card[]
  statements  Statement[]
  importBlocks ImportBlock[]
  charges CardCharge[]
  installmentPlans InstallmentPlan[]
  @@unique([id, userId])
  @@unique([userId, creationKey])
}

model Card {
  id              String @id @default(uuid())
  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditAccountId String
  creditAccount   CreditAccount @relation(fields: [creditAccountId, userId], references: [id, userId], onDelete: Restrict)
  name            String @db.VarChar(100)
  kind            String @db.VarChar(10)
  creationKey     String @db.VarChar(100)
  createdAt       DateTime @default(now())
  importBlocks    ImportBlock[]
  charges         CardCharge[]
  @@unique([id, userId])
  @@unique([id, creditAccountId, userId])
  @@unique([userId, creationKey])
  @@index([creditAccountId, userId])
}

model Statement {
  id              String @id @default(uuid())
  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditAccountId String
  creditAccount   CreditAccount @relation(fields: [creditAccountId, userId], references: [id, userId], onDelete: Restrict)
  period          String @db.VarChar(7)
  periodOrigin    String @default("manual") @db.VarChar(10)
  creationKey     String @db.VarChar(100)
  version         Int @default(0)
  closingOn       DateTime? @db.Date
  dueOn           DateTime? @db.Date
  declaredTotal   BigInt?
  cycle           String? @db.VarChar(6)
  coverage        String? @db.VarChar(8)
  coverageHash    String? @db.VarChar(64)
  factEvidence    Json @default("{}")
  factChanges     StatementFactChange[]
  paymentBasis    StatementPaymentBasis?
  paymentCommands StatementPaymentCommand[]
  createdAt       DateTime @default(now())
  importBlocks    ImportBlock[]
  charges         CardCharge[]
  @@unique([id, userId])
  @@unique([id, creditAccountId, userId])
  @@unique([userId, creationKey])
  @@unique([creditAccountId, period])
  @@index([creditAccountId, userId])
}

model StatementFactChange {
  id              String @id @default(uuid())
  userId          String
  creditAccountId String
  statementId     String
  statement       Statement @relation(fields: [statementId, creditAccountId, userId], references: [id, creditAccountId, userId], onDelete: Restrict)
  version         Int
  changes         Json
  createdAt       DateTime @default(now())
  @@unique([statementId, version])
  @@index([statementId, userId])
}

model ImportBatch {
  id             String @id @default(uuid())
  userId         String
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename       String @db.VarChar(160)
  format         String @db.VarChar(3)
  configuration  Json
  requestHash    String @db.VarChar(64)
  creationKey    String @db.VarChar(100)
  status         String @default("uploaded") @db.VarChar(10)
  version        Int @default(0)
  size           Int
  rowCount       Int @default(0)
  attempts       Int @default(0)
  leaseToken     String?
  leaseUntil     DateTime?
  errorCode      String? @db.VarChar(100)
  parsedMetadata Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  file           ImportFile?
  blocks         ImportBlock[]
  revisions      ImportReviewRevision[]
  confirmation   ImportConfirmation?
  outcomes       ImportOutcome[]
  @@unique([id, userId])
  @@unique([userId, creationKey])
  @@index([status, leaseUntil, createdAt])
  @@index([userId, createdAt])
}

model ImportFile {
  batchId String @id
  userId  String
  batch   ImportBatch @relation(fields: [batchId, userId], references: [id, userId], onDelete: Cascade)
  bytes   Bytes
  @@unique([batchId, userId])
}

model ImportBlock {
  id                 String @id
  batchId            String
  userId             String
  batch              ImportBatch @relation(fields: [batchId, userId], references: [id, userId], onDelete: Cascade)
  kind               String @db.VarChar(4)
  metadata           Json
  financialAccountId String?
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId, userId], references: [id, userId], onDelete: Restrict)
  creditAccountId    String?
  creditAccount      CreditAccount? @relation(fields: [creditAccountId, userId], references: [id, userId], onDelete: Restrict)
  cardId             String?
  card               Card? @relation(fields: [cardId, creditAccountId, userId], references: [id, creditAccountId, userId], onDelete: Restrict)
  statementId        String?
  statement          Statement? @relation(fields: [statementId, creditAccountId, userId], references: [id, creditAccountId, userId], onDelete: Restrict)
  periodOverride     Boolean @default(false)
  decisionId         String?
  sources            ImportSourceRecord[]
  @@unique([id, batchId, userId])
  @@index([batchId, userId])
}

model ImportSourceRecord {
  id         String @id
  batchId    String
  userId     String
  blockId    String
  block      ImportBlock @relation(fields: [blockId, batchId, userId], references: [id, batchId, userId], onDelete: Cascade)
  ordinal    Int
  raw        String
  fields     Json
  period     Json
  row        ImportRow?
  outcome    ImportOutcome?
  @@unique([id, batchId, userId])
  @@unique([batchId, ordinal])
}

model ImportRow {
  id             String @id
  batchId        String
  userId         String
  sourceRecordId String
  source         ImportSourceRecord @relation(fields: [sourceRecordId, batchId, userId], references: [id, batchId, userId], onDelete: Cascade)
  candidate      Json
  corrections    Json @default("{}")
  selected       Boolean @default(true)
  action         String @default("create") @db.VarChar(6)
  reason         String? @db.VarChar(500)
  linkBankEntryId String?
  linkBankEntry BankEntry? @relation("BankLink", fields: [linkBankEntryId, userId], references: [id, userId], onDelete: Restrict)
  linkCardChargeId String?
  linkCardCharge CardCharge? @relation("CardLink", fields: [linkCardChargeId, userId], references: [id, userId], onDelete: Restrict)
  distinctBankEntryId String?
  distinctBankEntry BankEntry? @relation("BankDistinct", fields: [distinctBankEntryId, userId], references: [id, userId], onDelete: Restrict)
  distinctCardChargeId String?
  distinctCardCharge CardCharge? @relation("CardDistinct", fields: [distinctCardChargeId, userId], references: [id, userId], onDelete: Restrict)
  @@unique([sourceRecordId, batchId, userId])
  @@index([batchId, userId])
}

model ImportReviewRevision {
  id        String @id @default(uuid())
  batchId   String
  userId    String
  batch     ImportBatch @relation(fields: [batchId, userId], references: [id, userId], onDelete: Cascade)
  version   Int
  changes   Json
  createdAt DateTime @default(now())
  @@unique([batchId, version])
}

model Expense {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  description String @db.VarChar(500)
  notes String? @db.VarChar(1000)
  purchasedOn DateTime? @db.Date
  total BigInt?
  currency String @default("BRL") @db.VarChar(3)
  factEvidence Json @default("{}")
  version Int @default(0)
  createdAt DateTime @default(now())
  charges ExpenseCharge[]
  commands ExpenseCommand[]
  installmentPlan InstallmentPlan?
  @@unique([id, userId])
  @@index([userId, createdAt])
}

model ExpenseCharge {
  chargeId String @id
  userId String
  expenseId String
  expense Expense @relation(fields: [expenseId, userId], references: [id, userId], onDelete: Restrict)
  charge CardCharge @relation(fields: [chargeId, userId], references: [id, userId], onDelete: Restrict)
  installmentMatch InstallmentMatch?
  createdAt DateTime @default(now())
  @@unique([chargeId, userId])
  @@unique([chargeId, expenseId, userId])
  @@index([expenseId, userId])
}

model ExpenseCommand {
  id String @id @default(uuid())
  userId String
  expenseId String
  expense Expense @relation(fields: [expenseId, userId], references: [id, userId], onDelete: Restrict)
  key String @db.VarChar(100)
  requestHash String @db.VarChar(64)
  version Int
  changes Json
  result Json
  createdAt DateTime @default(now())
  @@unique([userId, key])
  @@unique([expenseId, version])
  @@index([expenseId, userId])
}

model InstallmentPlan {
  id String @id @default(uuid())
  userId String
  expenseId String @unique
  expense Expense @relation(fields: [expenseId, userId], references: [id, userId], onDelete: Restrict)
  creditAccountId String
  creditAccount CreditAccount @relation(fields: [creditAccountId, userId], references: [id, userId], onDelete: Restrict)
  total BigInt
  currency String @default("BRL") @db.VarChar(3)
  count Int
  firstPeriod String @db.VarChar(7)
  cadence String @default("monthly") @db.VarChar(7)
  evidence Json
  createdAt DateTime @default(now())
  forecasts InstallmentForecast[]
  @@unique([expenseId, userId])
  @@unique([id, expenseId, userId])
  @@index([creditAccountId, userId])
}

model InstallmentForecast {
  id String @id @default(uuid())
  userId String
  expenseId String
  planId String
  plan InstallmentPlan @relation(fields: [planId, expenseId, userId], references: [id, expenseId, userId], onDelete: Restrict)
  number Int
  period String @db.VarChar(7)
  plannedCents BigInt
  match InstallmentMatch?
  @@unique([planId, number])
  @@unique([id, expenseId, userId])
  @@index([expenseId, userId])
}

model InstallmentMatch {
  forecastId String @id
  expenseId String
  userId String
  forecast InstallmentForecast @relation(fields: [forecastId, expenseId, userId], references: [id, expenseId, userId], onDelete: Restrict)
  chargeId String @unique
  expenseCharge ExpenseCharge @relation(fields: [chargeId, expenseId, userId], references: [chargeId, expenseId, userId], onDelete: Restrict)
  confirmedCents BigInt
  evidence Json
  createdAt DateTime @default(now())
  @@unique([forecastId, expenseId, userId])
  @@unique([chargeId, expenseId, userId])
}

model BankEntry {
  id String @id @default(uuid())
  userId String
  accountId String
  account FinancialAccount @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  postedOn DateTime @db.Date
  description String @db.VarChar(500)
  cents BigInt
  currency String @default("BRL") @db.VarChar(3)
  fingerprint String @db.VarChar(64)
  notes String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  identities BankExternalIdentity[]
  outcomes ImportOutcome[]
  linkRows ImportRow[] @relation("BankLink")
  distinctRows ImportRow[] @relation("BankDistinct")
  version Int @default(0)
  paymentSource StatementPaymentSource?
  paymentCommands StatementPaymentCommand[]
  @@unique([id, userId])
  @@unique([id, accountId, userId])
  @@index([userId, fingerprint])
  @@index([accountId, userId, postedOn])
}

model StatementPaymentBasis {
  statementId String @id
  creditAccountId String
  userId String
  statement Statement @relation(fields: [statementId, creditAccountId, userId], references: [id, creditAccountId, userId], onDelete: Restrict)
  kind String @db.VarChar(10)
  total BigInt
  referenceHash String @db.VarChar(64)
  evidence Json
  snapshot Json
  allocations StatementPaymentAllocation[]
  @@unique([statementId, creditAccountId, userId])
}

model StatementPaymentSource {
  bankEntryId String @id
  accountId String
  userId String
  bankEntry BankEntry @relation(fields: [bankEntryId, accountId, userId], references: [id, accountId, userId], onDelete: Restrict)
  originalCents BigInt
  confirmedCents BigInt
  evidence Json
  allocations StatementPaymentAllocation[]
  @@unique([bankEntryId, accountId, userId])
}

model StatementPaymentAllocation {
  id String @id @default(uuid())
  statementId String
  creditAccountId String
  userId String
  basis StatementPaymentBasis @relation(fields: [statementId, creditAccountId, userId], references: [statementId, creditAccountId, userId], onDelete: Restrict)
  bankEntryId String
  accountId String
  source StatementPaymentSource @relation(fields: [bankEntryId, accountId, userId], references: [bankEntryId, accountId, userId], onDelete: Restrict)
  cents BigInt
  evidence Json
  createdAt DateTime @default(now())
  reversedAt DateTime?
  reversalId String?
  @@index([statementId, userId])
  @@index([bankEntryId, userId])
}

model StatementPaymentCommand {
  id String @id @default(uuid())
  userId String
  statementId String
  creditAccountId String
  statement Statement @relation(fields: [statementId, creditAccountId, userId], references: [id, creditAccountId, userId], onDelete: Restrict)
  bankEntryId String?
  accountId String?
  bankEntry BankEntry? @relation(fields: [bankEntryId, accountId, userId], references: [id, accountId, userId], onDelete: Restrict)
  key String @db.VarChar(100)
  requestHash String @db.VarChar(64)
  changes Json
  result Json
  createdAt DateTime @default(now())
  @@unique([userId, key])
  @@index([statementId, userId])
}

model CardCharge {
  id String @id @default(uuid())
  userId String
  creditAccountId String
  creditAccount CreditAccount @relation(fields: [creditAccountId, userId], references: [id, userId], onDelete: Restrict)
  statementId String
  statement Statement @relation(fields: [statementId, creditAccountId, userId], references: [id, creditAccountId, userId], onDelete: Restrict)
  cardId String?
  card Card? @relation(fields: [cardId, creditAccountId, userId], references: [id, creditAccountId, userId], onDelete: Restrict)
  postedOn DateTime @db.Date
  description String @db.VarChar(500)
  cents BigInt
  currency String @default("BRL") @db.VarChar(3)
  installment Json
  fingerprint String @db.VarChar(64)
  notes String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  identities CardExternalIdentity[]
  outcomes ImportOutcome[]
  linkRows ImportRow[] @relation("CardLink")
  distinctRows ImportRow[] @relation("CardDistinct")
  expenseLink ExpenseCharge?
  version Int @default(0)
  classificationKind String? @db.VarChar(16)
  classifiedCents BigInt?
  classificationEvidence Json @default("{}")
  commands CardChargeCommand[]
  @@unique([id, userId])
  @@unique([id, creditAccountId, userId])
  @@index([userId, fingerprint])
  @@index([creditAccountId, userId, postedOn])
}

model CardChargeCommand {
  id String @id @default(uuid())
  userId String
  creditAccountId String
  chargeId String
  charge CardCharge @relation(fields: [chargeId, creditAccountId, userId], references: [id, creditAccountId, userId], onDelete: Restrict)
  key String @db.VarChar(100)
  requestHash String @db.VarChar(64)
  version Int
  changes Json
  result Json
  createdAt DateTime @default(now())
  @@unique([userId, key])
  @@unique([chargeId, version])
  @@index([chargeId, userId])
}

model BankExternalIdentity {
  id String @id @default(uuid())
  userId String
  accountId String
  namespace String @db.VarChar(100)
  externalId String @db.VarChar(256)
  entryId String
  entry BankEntry @relation(fields: [entryId, accountId, userId], references: [id, accountId, userId], onDelete: Restrict)
  @@unique([userId, accountId, namespace, externalId])
}

model CardExternalIdentity {
  id String @id @default(uuid())
  userId String
  creditAccountId String
  namespace String @db.VarChar(100)
  externalId String @db.VarChar(256)
  chargeId String
  charge CardCharge @relation(fields: [chargeId, creditAccountId, userId], references: [id, creditAccountId, userId], onDelete: Restrict)
  @@unique([userId, creditAccountId, namespace, externalId])
}

model ImportConfirmation {
  id String @id @default(uuid())
  userId String
  batchId String @unique
  batch ImportBatch @relation(fields: [batchId, userId], references: [id, userId], onDelete: Restrict)
  key String @db.VarChar(100)
  reviewVersion Int
  result Json
  createdAt DateTime @default(now())
  @@unique([batchId, userId])
  @@unique([userId, key])
}

model ImportOutcome {
  sourceRecordId String @id
  batchId String
  userId String
  source ImportSourceRecord @relation(fields: [sourceRecordId, batchId, userId], references: [id, batchId, userId], onDelete: Restrict)
  batch ImportBatch @relation(fields: [batchId, userId], references: [id, userId], onDelete: Restrict)
  action String @db.VarChar(7)
  entryId String?
  entry BankEntry? @relation(fields: [entryId, userId], references: [id, userId], onDelete: Restrict)
  chargeId String?
  charge CardCharge? @relation(fields: [chargeId, userId], references: [id, userId], onDelete: Restrict)
  decision Json
  @@unique([sourceRecordId, batchId, userId])
  @@index([batchId, userId])
}
