{
  "name": "rovere-finance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.14.0 <25", "npm": ">=11" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:api": "npm run dev --workspace=@rovere/api",
    "dev:web": "npm run dev --workspace=@rovere/web",
    "build": "npm run build --workspace=@rovere/domain && npm run build --workspace=@rovere/api && npm run build --workspace=@rovere/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build --workspace=@rovere/api && vitest run",
    "docs:check": "node scripts/check-docs.mjs",
    "smoke:web": "node scripts/smoke-web.mjs",
    "check": "npm run docs:check && npm run typecheck && npm run test && npm run build && npm run smoke:web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
